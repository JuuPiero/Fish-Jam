{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "hot-reload",
    "version": "1.0.0",
    "author": "Thanh Hoang",
    "editor": ">=3.8.6",
    "scripts": {
        "preinstall": "node ./scripts/preinstall.js",
        "build": "tsc && node ./scripts/build.js",
        "typecheck": "tsc",
        "test": "node ./tests/run.js"
    },
    "description": "i18n:hot-reload.description",
    "main": "./dist/main.js",
    "devDependencies": {
        "@cocos/creator-types": "^3.8.6",
        "@types/node": "^18.17.1",
        "esbuild": "^0.24.2",
        "typescript": "^5.8.2"
    },
    "contributions": {
        "scene": {
            "script": "./dist/scene.js"
        },
        "menu": [
            {
                "path": "i18n:menu.extension/Hot Reload",
                "label": "i18n:hot-reload.menu.toggle",
                "message": "toggle-enabled"
            },
            {
                "path": "i18n:menu.extension/Hot Reload",
                "label": "i18n:hot-reload.menu.restart",
                "message": "restart-game"
            },
            {
                "path": "i18n:menu.extension/Hot Reload",
                "label": "i18n:hot-reload.menu.diagnostics",
                "message": "save-diagnostics"
            },
            {
                "path": "i18n:menu.extension/Hot Reload",
                "label": "i18n:hot-reload.menu.docs",
                "message": "open-docs"
            }
        ],
        "messages": {
            "programming:pack-build-end": { "methods": ["onPackBuilt"] },
            "programming:compiled": { "methods": ["onPackBuilt"] },
            "get-config": { "methods": ["getConfig"] },
            "report": { "methods": ["report"] },
            "diagnostics": { "methods": ["diagnostics"] },
            "toggle-enabled": { "methods": ["toggleEnabled"] },
            "restart-game": { "methods": ["restartGame"] },
            "save-diagnostics": { "methods": ["saveDiagnostics"] },
            "open-docs": { "methods": ["openDocs"] }
        }
    }
}
