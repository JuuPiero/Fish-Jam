{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "unity-style",
    "version": "1.0.0",
    "author": "Thanh Hoang",
    "editor": ">=3.8.6",
    "scripts": {
        "preinstall": "node ./scripts/preinstall.js",
        "build": "tsc && node ./scripts/build.js",
        "watch": "node ./scripts/build.js --watch",
        "typecheck": "tsc",
        "test": "node ./tests/run.js",
        "test:engine": "node ./tests/engine/build.js"
    },
    "description": "i18n:unity-style.description",
    "main": "./dist/main.js",
    "devDependencies": {
        "@cocos/creator-types": "^3.8.6",
        "@types/node": "^18.17.1",
        "esbuild": "^0.24.2",
        "typescript": "^5.8.2",
        "jsdom": "^24.1.3"
    },
    "contributions": {
        "asset-db": {
            "mount": {
                "path": "./assets",
                "readonly": false
            }
        },
        "menu": [
            {
                "path": "i18n:menu.extension/Unity Style",
                "label": "i18n:unity-style.menu.docs",
                "message": "open-docs"
            }
        ],
        "assets": {
            "menu": {
                "methods": "./dist/assets-menu.js",
                "createMenu": "onCreateMenu"
            }
        },
        "messages": {
            "open-docs": {
                "methods": [
                    "openDocs"
                ]
            },
            "create-script": {
                "methods": [
                    "createScript"
                ]
            },
            "create-script-at": {
                "methods": [
                    "createScriptAt"
                ]
            }
        }
    }
}
