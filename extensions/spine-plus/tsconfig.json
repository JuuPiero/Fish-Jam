{
    "extends": "./base.tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "rootDir": ".",
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "types": [
            "node",
            "@cocos/creator-types/editor",
            "@cocos/creator-types/engine"
        ]
    },
    "include": ["source/**/*.ts", "assets/**/*.ts", "tests/**/*.ts", "types/**/*.d.ts"],
    "exclude": ["tests/out", "tests/preview/out"]
}
