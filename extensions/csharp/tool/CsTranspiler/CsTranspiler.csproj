<Project Sdk="Microsoft.NET.Sdk">
  <!-- C# -> TypeScript transpiler for Cocos Creator scripts (Roslyn). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CsTranspiler</RootNamespace>
    <AssemblyName>CsTranspiler</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- copied next to the tool; loaded as metadata, never executed -->
    <ProjectReference Include="..\Cocos.Bindings\Cocos.Bindings.csproj" />
  </ItemGroup>
</Project>
