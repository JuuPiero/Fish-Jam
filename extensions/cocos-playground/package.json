{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "cocos-playground",
    "version": "1.2.0",
    "author": "thanhhh",
    "editor": ">=3.8.6",
    "scripts": {
        "preinstall": "node ./scripts/preinstall.js",
        "build": "node ./scripts/build.js",
        "pack": "node ./scripts/pack.js",
        "watch": "tsc -w",
        "preview": "node ./tests/preview/build.js"
    },
    "description": "i18n:cocos-playground.description",
    "main": "./dist/main.js",
    "devDependencies": {
        "@cocos/creator-types": "^3.8.6",
        "@types/jszip": "^3.4.0",
        "@types/mime-types": "^2.1.4",
        "@types/node": "^18.17.1",
        "cheerio": "1.0.0-rc.12",
        "esbuild": "^0.28.2",
        "jszip": "^3.10.1",
        "mime-types": "^2.1.35",
        "playable-adapter-core": "file:vendor/playable-adapter-core-1.2.4-ikame.1.tgz",
        "typescript": "^5.8.2",
        "vue": "^3.3.4"
    },
    "panels": {
        "default": {
            "title": "Cocos Playground",
            "type": "dockable",
            "main": "dist/panels/default",
            "size": {
                "min-width": 340,
                "min-height": 360,
                "width": 420,
                "height": 640
            }
        }
    },
    "contributions": {
        "asset-db": {
            "mount": {
                "path": "./runtime/assets",
                "readonly": true
            }
        },
        "menu": [
            {
                "path": "i18n:cocos-playground",
                "label": "i18n:cocos-playground.open_panel",
                "message": "open-panel"
            },
            {
                "path": "i18n:cocos-playground",
                "label": "i18n:cocos-playground.export_playable",
                "message": "export-playable"
            }
        ],
        "messages": {
            "open-panel": { "methods": ["openPanel"] },
            "export-playable": { "methods": ["exportPlayable"] },
            "panel-state": { "methods": ["panelState"] },
            "panel-refresh": { "methods": ["panelRefresh"] },
            "set-server-url": { "methods": ["setServerUrl"] },
            "sign-in": { "methods": ["signIn"] },
            "cancel-sign-in": { "methods": ["cancelSignIn"] },
            "sign-out": { "methods": ["signOut"] },
            "list-applications": { "methods": ["listApplications"] },
            "list-concepts": { "methods": ["listConcepts"] },
            "create-concept": { "methods": ["createConcept"] },
            "select": { "methods": ["select"] },
            "list-exports": { "methods": ["listExports"] },
            "delete-export": { "methods": ["deleteExport"] },
            "check-project": { "methods": ["checkProject"] },
            "build": { "methods": ["build"] },
            "package-existing": { "methods": ["packageExisting"] },
            "upload-export": { "methods": ["uploadExport"] },
            "list-channels": { "methods": ["listChannels"] },
            "estimate": { "methods": ["estimate"] },
            "list-playables": { "methods": ["listPlayables"] },
            "preview-playable": { "methods": ["previewPlayable"] },
            "copy-playable-values": { "methods": ["copyPlayableValues"] },
            "open-url": { "methods": ["openUrl"] },
            "reveal": { "methods": ["reveal"] },
            "cocos-playground:state": { "methods": ["default.onState"] }
        }
    }
}
