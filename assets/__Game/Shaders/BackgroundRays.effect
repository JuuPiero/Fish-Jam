CCEffect %{
	techniques:
	- passes:
		- vert: sprite-vs:vert
			frag: background-rays-fs:frag
			rasterizerState:
				cullMode: none
			depthStencilState:
				depthTest: false
				depthWrite: false
			blendState:
				targets:
				- blend: true
					blendSrc: one
					blendDst: one
					blendSrcAlpha: one
					blendDstAlpha: one
			properties:
				tintColor: { value: [0.75, 0.96, 1, 1], editor: { type: color } }
				intensity: { value: 2.0 }
				vHeight: { value: 0.7 }
				sway: { value: 0.05 }
				speed: { value: 1.0 }
				pulse: { value: 0.35 }
				timeOffset: { value: 0.0 }
}%

CCProgram sprite-vs %{
	precision highp float;
	#include <builtin/uniforms/cc-global>
	#if USE_LOCAL
		#include <builtin/uniforms/cc-local>
	#endif
	#if SAMPLE_FROM_RT
		#include <common/common-define>
	#endif

	in vec3 a_position;
	in vec2 a_texCoord;
	in vec4 a_color;

	out vec4 color;
	out vec2 uv0;

	vec4 vert () {
		vec4 pos = vec4(a_position, 1.0);
		#if USE_LOCAL
			pos = cc_matWorld * pos;
		#endif
		#if USE_PIXEL_ALIGNMENT
			pos = cc_matView * pos;
			pos.xyz = floor(pos.xyz);
			pos = cc_matProj * pos;
		#else
			pos = cc_matViewProj * pos;
		#endif

		uv0 = a_texCoord;
		#if SAMPLE_FROM_RT
			CC_HANDLE_RT_SAMPLE_FLIP(uv0);
		#endif
		color = a_color;
		return pos;
	}
}%

CCProgram background-rays-fs %{
	precision highp float;
	#include <builtin/uniforms/cc-global>
	#include <builtin/internal/embedded-alpha>

	in vec2 uv0;
	in vec4 color;

	#pragma builtin(local)
	layout(set = 2, binding = 11) uniform sampler2D cc_spriteTexture;
	uniform BackgroundRaysParams {
		vec4 tintColor;
		float intensity;
		float vHeight;
		float sway;
		float speed;
		float pulse;
		float timeOffset;
	};

	vec4 frag () {
		float t = (cc_time.x + timeOffset) * speed;
		float fromTop = clamp((1.0 - uv0.y) / vHeight, 0.0, 1.0);

		float swayA = sin(t * 0.9) * sway * fromTop;
		float swayB = sin(t * 0.7 + 2.1) * sway * 1.2 * fromTop;
		float breathe = 1.08 + 0.03 * sin(t * 0.5);
		vec2 uvA = vec2(uv0.x + swayA, uv0.y);
		vec2 uvB = vec2((uv0.x - 0.5) * breathe + 0.5 + swayB, uv0.y);

		vec3 rays = (CCSampleWithAlphaSeparated(cc_spriteTexture, uvA).rgb
			+ CCSampleWithAlphaSeparated(cc_spriteTexture, uvB).rgb) * 0.65;

		float pulseFactor = 1.0 + pulse * sin(t * 1.3 + uv0.x * 9.0 - fromTop * 4.0);
		float fadeIn = smoothstep(0.0, 0.06, fromTop);
		float vertexAlpha = color.a * tintColor.a;
		vec3 outputRgb = rays * color.rgb * tintColor.rgb
			* (intensity * pulseFactor * fadeIn * vertexAlpha);

		return vec4(outputRgb, 1.0);
	}
}%
